# Copie ce fichier en .env.local et remplis-le. Jamais commité (.env* est dans .gitignore).

# --- Sessions ---
# Secret de signature des cookies (32+ caractères aléatoires). Généré par : npm run generate-secret
APP_SESSION_SECRET=

# --- Pronote ---
# Chaque élève se connecte avec son propre identifiant et mot de passe Pronote.
# Adresse Pronote proposée à la connexion (celle de l'établissement par défaut).
PRONOTE_DEFAULT_URL=http://nice.ilec.fr/mobile.eleve.html

# Établissements autorisés, séparés par des virgules (ex. : nice.ilec.fr,0123456a.index-education.net).
# « * » accepte tous les établissements. Vide : seul celui de PRONOTE_DEFAULT_URL est accepté,
# et l'élève n'a alors même pas à saisir d'adresse.
PRONOTI_ALLOWED_HOSTS=

# --- Fuseau horaire ---
# Fuseau de l'établissement (heures des cours). Par défaut : Europe/Paris.
# Exemples hors métropole : Indian/Reunion, America/Martinique, Pacific/Noumea.
NEXT_PUBLIC_PRONOTI_TIMEZONE=
